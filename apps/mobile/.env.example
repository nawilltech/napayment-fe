# Copy to apps/mobile/.env.local for local development.
# Android emulator: use http://10.0.2.2:8080. A physical phone: your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Public pay-page base for sharing payment links, e.g. https://pay.napayment.ng/p
# Leave unset until a hosted pay page exists - links are then shared by short code.
EXPO_PUBLIC_PAY_LINK_BASE_URL=
